# ==============================================================================
# Smart Heritage - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local to customize for your local setup.
#
# PostgreSQL DataSource:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_heritage
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Configuration:
# - secret: phải dài đủ (>= 256 bits) để dùng HMAC-SHA
# - expiration-ms: thời gian hết hạn JWT (mặc định 86400000 ms = 24 giờ)
JWT_SECRET=SmartHeritageDevSecretKeyThatIsAtLeast256BitsLong!2024
JWT_EXPIRATION_MS=86400000

# CORS Configuration:
# - allowed-origins: danh sách origin được phép gọi API, phân cách bằng dấu phẩy.
#   Mặc định: http://localhost:5173 (Admin Web Vite), http://localhost:8081 (Expo Web)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ==============================================================================
# Lưu ý:
# - Không đưa secret/token thực tế vào file này khi commit lên Git.
# - Trong production, hãy cung cấp các biến qua môi trường/Docker secret.
# ==============================================================================
