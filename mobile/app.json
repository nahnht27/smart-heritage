{
  "expo": {
    "name": "Smart Heritage",
    "slug": "smart-heritage",
    "description": "Smart Heritage visitor mobile app for beacon-guided heritage discovery.",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartheritage",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.university.smartheritage",
      "buildNumber": "2",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.university.smartheritage",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/with-beacon-permissions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
