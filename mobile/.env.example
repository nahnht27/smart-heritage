# ==============================================================================
# Smart Heritage - Mobile App Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local to customize for your local setup.
# In Expo, variables prefixed with EXPO_PUBLIC_ are exposed to client code.
#
# Backend API Base URL:
# - Backend M1 prefix is `/api` (NOT `/api/v1`).
# - Web browser / iOS Simulator: http://localhost:8080/api
# - Android Emulator:            http://10.0.2.2:8080/api
# - Physical Device (via LAN):   http://<YOUR_COMPUTER_LOCAL_IP>:8080/api
# ==============================================================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
