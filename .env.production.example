# ==============================================================================
# Smart Heritage - Production environment (example)
# ==============================================================================
# Copy to `.env.production` and replace every CHANGE_ME value. Never commit
# `.env.production`. Never reuse development secrets in production.
#
# Generate strong secrets, for example:
#   openssl rand -base64 48      # JWT_SECRET
#   openssl rand -base64 32      # POSTGRES_PASSWORD
# ==============================================================================

# Release/image version label (Semantic Versioning, no `v` prefix required).
APP_VERSION=1.0.0

# PostgreSQL (internal network only; no published port).
POSTGRES_DB=smart_heritage
POSTGRES_USER=smart_heritage_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# JWT signing secret (>= 256 bits). Must differ from local development.
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call the API directly. Use the public HTTPS origin
# of the Admin Web (no trailing slash).
CORS_ALLOWED_ORIGINS=https://your-domain.example

# Host binding for the Nginx frontend/reverse proxy.
# Keep 127.0.0.1 when an external TLS proxy (Nginx/Caddy/Traefik) runs on the
# same host. Change to 0.0.0.0 only if another machine terminates TLS.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080

# Public backend origin baked into the Admin Web bundle at build time.
# Leave empty for same-origin requests: the frontend Nginx proxies `/api` to
# the internal backend. Set to the public HTTPS origin (WITHOUT `/api`) only if
# the API is served from a different origin.
VITE_API_BASE_URL=
