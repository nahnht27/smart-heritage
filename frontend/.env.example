VITE_API_BASE_URL=http://localhost:8080

# CORS (quan trọng): Đảm bảo backend đã cấu hình CORS cho origin của bạn.
# Mặc định backend cho phép: http://localhost:5173 (Admin Web), http://localhost:8081 (Expo Web).
# Nếu frontend chạy trên origin khác, hãy thêm vào biến CORS_ALLOWED_ORIGINS của backend.
# Prefix API là /api (không phải /api/v1).
